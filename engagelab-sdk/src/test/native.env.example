ENGAGELAB_VOICE_LANGUAGE=en
ENGAGELAB_SCHEDULE_DELAY=45
ENGAGELAB_SCHEDULE_OBSERVATION=15
ENGAGELAB_ADB_PATH=adb
ENGAGELAB_ADB_SERIAL=
