ENGAGELAB_DEVICE_APP_KEY=

# Optional existing lifecycle evidence (set both or neither).
ENGAGELAB_LIFECYCLE_MESSAGE_ID=
ENGAGELAB_LIFECYCLE_REGISTRATION_ID=
