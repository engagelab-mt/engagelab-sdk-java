# Values are supplied locally or by CI. Never commit filled configuration.
TEST_ENV=qa
ENGAGELAB_BASE_URL=
ENGAGELAB_APP_KEY=
ENGAGELAB_MASTER_SECRET=
ENGAGELAB_HTTP_TIMEOUT=25
ENGAGELAB_WAIT_TIMEOUT=30
ENGAGELAB_REQUEST_INTERVAL=1.1
ENGAGELAB_RESOURCE_PREFIX=sdknative
ENGAGELAB_MUTATION_MODE=read_only
ENGAGELAB_TEST_REGISTRATION_ID=
ENGAGELAB_GROUP_KEY=
ENGAGELAB_GROUP_SECRET=
ENGAGELAB_GROUP_APP_KEYS=
ENGAGELAB_GROUP_TARGET_ALIAS=
ENGAGELAB_APNS_TOKEN=
ENGAGELAB_APNS_PRODUCTION=false
ENGAGELAB_BUNDLE_ID=
ENGAGELAB_RESULTS_DIR=.test-results

# Complete native acceptance suite; no credential values belong in this template.
ENGAGELAB_FULL_SUITE=integration
ENGAGELAB_FULL_RESULTS_DIR=.test-results/full
ENGAGELAB_FIXTURE_REGISTRATION_IDS=
ENGAGELAB_GROUP_APP_SECRETS=
